# ── Firebase (웹 SDK 설정 — 값은 실제 콘솔에서 복사) ──
# 클라이언트 노출이 필요하므로 NEXT_PUBLIC_ 접두사 (Firebase 웹 설정 공개는 정상, 보안은 Firestore 규칙으로 담보)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Gemini API ──
GEMINI_API_KEY=

# ── 교사용 대시보드 진입 PIN ──
TEACHER_PIN=

# ── 설문 URL (QR 연결 대상) ──
SURVEY_URL=

# ── 시연용 차시 웹앱 URL ──
DEMO_LESSON_URL=
